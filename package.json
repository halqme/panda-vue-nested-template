{
  "name": "panda-vue-nested-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "format": "vp fmt src/",
    "panda:codegen": "panda codegen",
    "panda:cssgen": "panda cssgen --max-warnings 0"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@pandacss/dev": "2.0.1",
    "@pandacss/preset-base": "2.0.1",
    "@pandacss/preset-panda": "2.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
